node_modules/
/out/
*.log
.DS_Store

# Secrets and local configuration: never commit. Wallet mnemonics, seeds and the
# emitter secret (METADATA_EMISSOR_SECRET) live outside the repository.
.env
.env.*
*.secret
*.mnemonic
*.seed
# The maintenance keys a staged deploy generates (scripts/staged-deploy.ts writes
# <row>.maintenance-key.json into MN_MAINTENANCE_KEY_DIR, which belongs outside the
# repository): never commit one, wherever it is written.
*.maintenance-key.json

# The private-state provider (midnight-js level-private-state-provider) creates this
# LevelDB in the working directory during a local deployment run.
midnight-level-db/

# Compiled contracts: the generated JS/TS, the ZKIR, the compiler metadata and the
# VERIFIER keys are committed (a public-interface bundle ships verifier keys and
# Level 2 compares them with the chain). Proving keys are not: they are large and a
# pure function of the ZKIR (scripts/compile.sh regenerates them).
contracts/managed/*/keys/*
!contracts/managed/*/keys/*.verifier
*.bzkir
