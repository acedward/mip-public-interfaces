}

circuit tm_emitTokenMetadata(
  domainSep: Bytes<32>,
  kind: Uint<8>,
  key: Bytes<32>,
  valType: Uint<8>,
  valLen: Uint<16>,
  value: Bytes<188>
): [] {
  assert(valLen <= tm_ONE_PART_VALUE_SIZE(),
         "TokenMetadata: a one-part value holds at most 188 bytes");
  tm_emitHead(domainSep, kind, key, valType, valLen, value);
}

